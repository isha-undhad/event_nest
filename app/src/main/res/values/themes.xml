<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.EventNest" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowBackground">@color/background</item>

        <!-- Global Text & Input Hint Contrast -->
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="colorOnSurfaceVariant">@color/text_hint</item>
        <item name="hintTextColor">@color/text_input_hint_selector</item>
        <item name="textInputStyle">@style/Widget.EventNest.TextInputLayout.OutlinedBox</item>
        <item name="editTextStyle">@style/Widget.EventNest.EditText</item>
    </style>

    <style name="Theme.EventNest" parent="Base.Theme.EventNest" />

    <!-- Shared Application TextInputLayout OutlinedBox Style -->
    <style name="Widget.EventNest.TextInputLayout.OutlinedBox" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="hintTextColor">@color/text_input_hint_selector</item>
        <item name="placeholderTextColor">@color/text_hint</item>
        <item name="startIconTint">@color/text_secondary</item>
        <item name="endIconTint">@color/text_secondary</item>
        <item name="boxStrokeColor">@color/primary</item>
    </style>

    <!-- Shared Application EditText Style -->
    <style name="Widget.EventNest.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>
</resources>